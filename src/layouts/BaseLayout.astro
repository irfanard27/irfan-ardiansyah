---
import "../assets/global.css";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Muhammad Irfan Ardiansyah — Senior Software Engineer | Frontend Specialist",
	description = "Senior Software Engineer with 10+ years of experience building scalable SaaS platforms, enterprise applications, and cloud-native systems. Bridging product design and engineering.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body class="bg-slate-50 text-neutral-900 antialiased leading-7 text-base">
		<header
			class="site-header sticky top-0 z-10 border-b border-transparent bg-transparent transition-all duration-300 ease-out"
			id="site-header"
		>
			<nav class="mx-auto flex w-[min(1080px,100%)] items-center justify-between gap-4 px-6 py-3">
				<a class="font-semibold tracking-tight" href="/">Irfan Ardiansyah</a>
				<div class="flex items-center gap-5 text-[0.98rem] text-neutral-600">
					<a class="transition-colors hover:text-neutral-900" href="/experience">Experience</a>
					<a class="transition-colors hover:text-neutral-900" href="/works">Works</a>
					<a class="transition-colors hover:text-neutral-900" href="mailto:personal.irfanardiansyah@gmail.com">Contact</a>
				</div>
			</nav>
		</header>
		<script>
			const header = document.getElementById("site-header");
			const onScroll = () => {
				if (!header) return;
				if (window.scrollY > 10) {
					header.classList.add("backdrop-blur-md", "bg-white/80", "border-neutral-200", "shadow-[0_1px_2px_rgba(15,23,42,0.02)]");
					header.classList.remove("bg-transparent", "border-transparent", "shadow-none");
				} else {
					header.classList.remove("backdrop-blur-md", "bg-white/80", "border-neutral-200", "shadow-[0_1px_2px_rgba(15,23,42,0.02)]");
					header.classList.add("bg-transparent", "border-transparent", "shadow-none");
				}
			};
			onScroll();
			window.addEventListener("scroll", onScroll, { passive: true });
		</script>
		<main class="mx-auto flex w-[min(1080px,100%)] flex-col gap-24 px-6 py-16 sm:gap-32 sm:py-24">
			<slot />
		</main>
		<footer class="border-t border-neutral-200/80 bg-transparent">
			<div class="mx-auto flex w-[min(1080px,100%)] flex-wrap items-center justify-between gap-4 px-6 py-8 text-[0.98rem] text-neutral-600">
				<p>© {new Date().getFullYear()} Muhammad Irfan Ardiansyah</p>
				<div class="flex items-center gap-4">
					<a class="transition-colors hover:text-neutral-900" href="mailto:personal.irfanardiansyah@gmail.com">Email</a>
					<a class="transition-colors hover:text-neutral-900" href="https://www.linkedin.com/in/irfanardiansyah/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
					<a class="transition-colors hover:text-neutral-900" href="https://github.com/irfanardiansyah" target="_blank" rel="noopener noreferrer">GitHub</a>
				</div>
			</div>
		</footer>
	</body>
</html>
