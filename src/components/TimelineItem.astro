---
import type { ExperienceItem } from "../data/experience";

interface Props {
	item: ExperienceItem;
	showRelated?: boolean;
}

const { item, showRelated = true } = Astro.props;
---

<article class="relative grid grid-cols-[auto,1fr] items-start gap-4 sm:gap-6">
	<div class="relative mt-2 h-2 w-2 rounded-full bg-neutral-900 shadow-[0_0_0_10px_rgba(0,0,0,0.01)]"></div>
	<div class="flex w-full flex-col gap-5 rounded-2xl bg-white p-6 shadow-[0_10px_30px_-20px_rgba(15,23,42,0.25)] sm:p-8">
		<header class="flex flex-col gap-1">
			<div class="text-xs uppercase tracking-[0.28em] text-neutral-500">
				{item.type === "freelance" ? "Freelance" : item.type === "contract" ? "Contract" : "Full-time"}
			</div>
			<h3 class="text-xl tracking-tight sm:text-2xl">{item.role}</h3>
			<div class="flex flex-wrap items-center gap-2 text-[0.98rem] text-neutral-600">
				<span>{item.company}</span>
				<span>•</span>
				<span>{item.period}</span>
				<span>•</span>
				<span>{item.location}</span>
			</div>
		</header>
		<div class="flex flex-col gap-3">
			<p class="text-xs uppercase tracking-[0.28em] text-neutral-500">Key Contributions</p>
			<ul class="flex flex-col gap-2 pl-5 text-neutral-600">
				{item.keyContributions.map((contribution) => (
					<li class="leading-relaxed">{contribution}</li>
				))}
			</ul>
		</div>
		<div class="flex flex-col gap-3">
			<p class="text-xs uppercase tracking-[0.28em] text-neutral-500">Tech Stack</p>
			<div class="flex flex-wrap gap-2">
				{item.techStack.map((tech) => (
					<span class="inline-flex items-center rounded-full border border-neutral-200 bg-white px-3 py-1 text-sm text-neutral-600">
						{tech}
					</span>
				))}
			</div>
		</div>
		{showRelated && item.relatedWorks && item.relatedWorks.length > 0 && (
			<a class="inline-flex items-center gap-2 text-neutral-600 transition-colors hover:text-neutral-900" href="/works">
				Related works →
			</a>
		)}
	</div>
</article>
