---
import { techIcons } from "../data/techIcons";

interface Props {
	label: string;
	showIcon?: boolean;
}

const { label, showIcon = true } = Astro.props;
const meta = techIcons[label];
---

<span
	class="inline-flex items-center gap-1.5 rounded-full border border-neutral-200 bg-white px-3 py-1 text-sm text-neutral-600"
>
	{
		showIcon && meta && (
			<img
				src={meta.icon}
				alt=""
				aria-hidden="true"
				loading="lazy"
				decoding="async"
				class="h-3.5 w-3.5"
			/>
		)
	}
	{label}
</span>
