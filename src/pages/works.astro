---
import BaseLayout from "../layouts/BaseLayout.astro";
import WorkCard from "../components/WorkCard.astro";
import UIDesignCard from "../components/UIDesignCard.astro";
import { works } from "../data/works";
import { uiDesigns } from "../data/uiDesigns";
---

<BaseLayout
	title="Works — Muhammad Irfan Ardiansyah"
	description="Selected portfolio showcasing frontend architecture, performance optimization, component systems, product delivery, and UI/UX design."
>
	<div class="flex flex-col gap-10">
		<header class="flex flex-col gap-2">
			<div class="text-xs uppercase tracking-[0.28em] text-neutral-500">Works</div>
			<h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">Selected Portfolio</h1>
			<p class="max-w-2xl text-neutral-600">
				Proof of work across SaaS platforms, enterprise systems, and freelance projects —
				alongside selected UI/UX design explorations.
			</p>
		</header>

		<div
			class="inline-flex w-fit items-center gap-1 rounded-full border border-neutral-200 bg-white p-1"
			role="tablist"
			aria-label="Work categories"
			data-works-tablist
		>
			<button
				type="button"
				role="tab"
				id="works-tab-web"
				aria-controls="works-panel-web"
				aria-selected="true"
				tabindex="0"
				data-works-tab="web"
				class="inline-flex items-center gap-2 rounded-full px-5 py-2 text-sm font-medium text-neutral-600 transition hover:text-neutral-900 aria-selected:bg-neutral-900 aria-selected:text-white"
			>
				Web
				<span class="text-xs opacity-70">{works.length}</span>
			</button>
			<button
				type="button"
				role="tab"
				id="works-tab-ui-ux"
				aria-controls="works-panel-ui-ux"
				aria-selected="false"
				tabindex="-1"
				data-works-tab="ui-ux"
				class="inline-flex items-center gap-2 rounded-full px-5 py-2 text-sm font-medium text-neutral-600 transition hover:text-neutral-900 aria-selected:bg-neutral-900 aria-selected:text-white"
			>
				UI/UX
				<span class="text-xs opacity-70">{uiDesigns.length}</span>
			</button>
		</div>

		<div
			role="tabpanel"
			id="works-panel-web"
			aria-labelledby="works-tab-web"
			data-works-panel="web"
		>
			<div class="grid gap-6 sm:grid-cols-2">
				{works.map((item) => <WorkCard item={item} />)}
			</div>
		</div>

		<div
			role="tabpanel"
			id="works-panel-ui-ux"
			aria-labelledby="works-tab-ui-ux"
			data-works-panel="ui-ux"
			hidden
		>
			<div class="grid gap-6 sm:grid-cols-2">
				{uiDesigns.map((item) => <UIDesignCard item={item} />)}
			</div>
		</div>
	</div>
</BaseLayout>

<script>
	const tablist = document.querySelector<HTMLElement>("[data-works-tablist]");

	if (tablist) {
		const tabs = Array.from(
			tablist.querySelectorAll<HTMLButtonElement>("[data-works-tab]"),
		);
		const panels = Array.from(
			document.querySelectorAll<HTMLElement>("[data-works-panel]"),
		);
		const defaultTab = tabs[0]?.dataset.worksTab ?? "web";

		const activate = (name: string, focus = false) => {
			const tab = tabs.find((item) => item.dataset.worksTab === name);
			if (!tab) return;

			tabs.forEach((item) => {
				const selected = item === tab;
				item.setAttribute("aria-selected", String(selected));
				item.tabIndex = selected ? 0 : -1;
				if (selected && focus) item.focus();
			});

			panels.forEach((panel) => {
				panel.hidden = panel.dataset.worksPanel !== name;
			});

			const hash = `#${name}`;
			if (window.location.hash !== hash) {
				history.replaceState(null, "", hash);
			}
		};

		tabs.forEach((tab, index) => {
			tab.addEventListener("click", () => {
				activate(tab.dataset.worksTab ?? defaultTab);
			});

			tab.addEventListener("keydown", (event) => {
				let nextIndex: number | undefined;

				if (event.key === "ArrowRight") {
					nextIndex = (index + 1) % tabs.length;
				} else if (event.key === "ArrowLeft") {
					nextIndex = (index - 1 + tabs.length) % tabs.length;
				} else if (event.key === "Home") {
					nextIndex = 0;
				} else if (event.key === "End") {
					nextIndex = tabs.length - 1;
				}

				if (nextIndex === undefined) return;

				event.preventDefault();
				const nextTab = tabs[nextIndex];
				activate(nextTab.dataset.worksTab ?? defaultTab, true);
			});
		});

		const hashTab = window.location.hash.replace("#", "");
		if (hashTab && tabs.some((tab) => tab.dataset.worksTab === hashTab)) {
			activate(hashTab);
		}

		window.addEventListener("hashchange", () => {
			const nextHash = window.location.hash.replace("#", "");
			if (tabs.some((tab) => tab.dataset.worksTab === nextHash)) {
				activate(nextHash);
			}
		});
	}
</script>
